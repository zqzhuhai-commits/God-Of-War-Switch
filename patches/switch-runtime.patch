+// GOW-Port: native EE timer services adapted from the upstream USA override,
+// with SCAJ SDK addresses verified by analysis. No game-state or wait-flag writes.
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ee_scheduler.h"
+#include <cstdio>
+namespace {
+void nativeDelay(uint8_t*,R5900Context *ctx,PS2Runtime *runtime) {
+ ctx->pc=GPR_U32(ctx,31);
+ if((ctx->cop0_status&0x10000u)==0){SET_GPR_S32(ctx,2,static_cast<int32_t>(0x80008008u));return;}
+ const uint64_t usec=GPR_U32(ctx,4);
+ runtime->eeScheduler().delayCurrent(usec*EeScheduler::kEeClockHz/1000000u);
+}
+void nativeTimerInit(uint8_t*,R5900Context *ctx,PS2Runtime*) {SET_GPR_S32(ctx,2,0);ctx->pc=GPR_U32(ctx,31);}
+void install(PS2Runtime &r) {
+ r.replaceFunction(0x00295AF0u,nativeDelay);
+ r.replaceFunction(0x0029A980u,nativeTimerInit);
+ r.replaceFunction(0x0029AAE0u,nativeTimerInit);
+ std::fprintf(stderr,"[scaj-timers] DelayThread uses native scheduler; legacy timer 2 init disabled\n");
+}
+}
+PS2_REGISTER_GAME_OVERRIDE("God of War (SCAJ-973.99 native timers)","GOWS_169.41",0x100008u,0u,install)
